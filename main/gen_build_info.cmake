# gen_build_info.cmake
# 在每次构建时重新生成 build_info.h，写入【真实构建时间】和【git 版本】。
# 这样启动日志里的构建信息始终准确，不再受 IDF esp_app_desc.c 增量编译不重编导致的
# "Compile time" 滞留旧日期问题影响。
#
# 用法: cmake -D OUT_FILE=<path> -D SRC_DIR=<project root> -P gen_build_info.cmake

if(NOT DEFINED OUT_FILE)
    set(OUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/build_info.h")
endif()
if(NOT DEFINED SRC_DIR)
    set(SRC_DIR ${CMAKE_CURRENT_SOURCE_DIR})
endif()

# 真实构建时间（脚本运行时刻 = 构建时刻）
string(TIMESTAMP BUILD_TIME "%Y-%m-%dT%H:%M:%S")

# git 版本描述（含 -dirty 标记若工作树有未提交改动）
execute_process(
    COMMAND git describe --dirty --always --tags
    WORKING_DIRECTORY ${SRC_DIR}
    OUTPUT_VARIABLE GIT_VER
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
if(NOT GIT_VER)
    set(GIT_VER "unknown")
endif()

# R158: 发行线版本 —— 最近的 v* 发布标签名(忽略距离, --abbrev=0)。
# git describe 默认会选“最近”的标签(可能是 R 回滚节点), 不适合给“关于”屏看;
# 发布标签(v2.0-stable 等)才是对用户说的版本。取不到时回退 dev。
execute_process(
    COMMAND git describe --tags --match "v*" --abbrev=0
    WORKING_DIRECTORY ${SRC_DIR}
    OUTPUT_VARIABLE GIT_RELEASE
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
if(NOT GIT_RELEASE)
    set(GIT_RELEASE "dev")
endif()

execute_process(
    COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY ${SRC_DIR}
    OUTPUT_VARIABLE GIT_HASH
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
if(NOT GIT_HASH)
    set(GIT_HASH "unknown")
endif()

file(WRITE ${OUT_FILE}
"#pragma once
/* AUTO-GENERATED by gen_build_info.cmake - DO NOT EDIT */
#define BUILD_INFO_TIME   \"${BUILD_TIME}\"
#define BUILD_INFO_VERSION \"${GIT_VER}\"
#define BUILD_INFO_RELEASE \"${GIT_RELEASE}\"
#define BUILD_INFO_GIT_HASH \"${GIT_HASH}\"

/* 在 app_main 早期调用，打印精准构建信息（取代 IDF 易过期的 Compile time） */
void build_info_print(void);
")
